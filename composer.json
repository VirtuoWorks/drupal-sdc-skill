{
    "name": "virtuoworks/drupal-sdc-skill",
    "description": "Development tools for the Drupal SDC skill",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "drupal/coder": "^9.0",
        "phpunit/phpunit": "^13.4",
        "symfony/yaml": "^8.1",
        "twig/twig": "^3.30"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "@php vendor/bin/phpcs",
        "phpcbf": "@php vendor/bin/phpcbf",
        "test": "@php vendor/bin/phpunit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "@php vendor/bin/phpunit --coverage-text --coverage-clover .phpunit.cache/coverage.xml --fail-on-warning",
            "@php tests/check-coverage.php .phpunit.cache/coverage.xml"
        ]
    }
}
