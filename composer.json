{
    "name": "virtuoworks/drupal-sdc-skill",
    "description": "Development tools for the Drupal SDC skill",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": [
            "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-clover .phpunit.cache/coverage.xml --fail-on-warning",
            "@php tests/check-coverage.php .phpunit.cache/coverage.xml"
        ]
    }
}
